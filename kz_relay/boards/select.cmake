# Explicit board selection; never reuse generated files across chip families.
set(KZ_BOARD "esp32_wroom" CACHE STRING "KZ board: esp32_wroom or esp32c6")
set_property(CACHE KZ_BOARD PROPERTY STRINGS esp32_wroom esp32c6)
if(KZ_BOARD STREQUAL "esp32_wroom")
    set(kz_target esp32)
    set(kz_default_gpio 26) # Provisional: verify actual board wiring first.
elseif(KZ_BOARD STREQUAL "esp32c6")
    set(kz_target esp32c6)
    set(kz_default_gpio 2)
else()
    message(FATAL_ERROR "Unsupported KZ_BOARD: ${KZ_BOARD}")
endif()
if(DEFINED KZ_CONFIGURED_BOARD AND NOT KZ_CONFIGURED_BOARD STREQUAL KZ_BOARD)
    message(FATAL_ERROR "Use a separate build directory for each board")
endif()
if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL kz_target)
    message(FATAL_ERROR "KZ_BOARD and IDF_TARGET disagree")
endif()
if(DEFINED ENV{IDF_TARGET} AND NOT "$ENV{IDF_TARGET}" STREQUAL "${kz_target}")
    message(FATAL_ERROR "KZ_BOARD and environment IDF_TARGET disagree")
endif()
set(KZ_CONFIGURED_BOARD "${KZ_BOARD}" CACHE INTERNAL "Board owning this build")
set(IDF_TARGET "${kz_target}" CACHE STRING "IDF target")
set(KZ_RELAY_GPIO "${kz_default_gpio}" CACHE STRING "Verified relay output GPIO")
set(KZ_RELAY_ACTIVE_HIGH "1" CACHE STRING "Relay polarity: 1 active-high, 0 active-low")
if(NOT KZ_RELAY_GPIO MATCHES "^(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "KZ_RELAY_GPIO must be a nonnegative decimal integer")
endif()
if(NOT KZ_RELAY_ACTIVE_HIGH MATCHES "^[01]$")
    message(FATAL_ERROR "KZ_RELAY_ACTIVE_HIGH must be 0 or 1")
endif()
# Refuse external/legacy SDKCONFIG paths that could contaminate another build.
if(DEFINED SDKCONFIG AND NOT SDKCONFIG STREQUAL "${CMAKE_BINARY_DIR}/sdkconfig")
    message(FATAL_ERROR "SDKCONFIG must be inside this build directory: ${CMAKE_BINARY_DIR}/sdkconfig")
endif()
set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig")
set(SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_LIST_DIR}/../sdkconfig.defaults;${CMAKE_CURRENT_LIST_DIR}/sdkconfig.defaults.${kz_target}")
